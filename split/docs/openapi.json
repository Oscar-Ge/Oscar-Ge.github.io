{
  "openapi": "3.1.0",
  "info": {
    "title": "Split Shared Ledger API",
    "version": "1.0.0",
    "description": "Public read/write by product design. No authentication required for REST. CORS is not authentication. Document writes require revision and are transactional; audit snapshots preserve prior versions."
  },
  "servers": [
    {
      "url": "https://oscar-shared-split.oscarge0319.chatgpt.site"
    },
    {
      "url": "http://terminal.local:4173",
      "description": "Local managed preview"
    }
  ],
  "paths": {
    "/api/books/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "getBook",
        "summary": "Read a public shared ledger",
        "responses": {
          "200": {
            "description": "Current book and version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookResponse"
                }
              }
            }
          },
          "404": {
            "description": "Book not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "replaceBook",
        "summary": "Atomically replace a ledger using optimistic concurrency",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "book",
                  "revision"
                ],
                "properties": {
                  "book": {
                    "$ref": "#/components/schemas/Book"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved; revision increments by one",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale revision; refresh and review the draft",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/books": {
      "post": {
        "operationId": "createBook",
        "summary": "Create a new public ledger",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "book"
                ],
                "properties": {
                  "book": {
                    "$ref": "#/components/schemas/Book"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "ID already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health",
        "summary": "Check database connectivity",
        "responses": {
          "200": {
            "description": "Connected",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/rent": {
      "get": {
        "operationId": "getRentStatus",
        "summary": "Read d6 rule, due months and balances without mutation",
        "responses": {
          "200": {
            "description": "Rule and status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "applyDueRent",
        "summary": "Idempotently insert due rent using server time, New York timezone",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "maxProperties": 0
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied or already up to date",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "bookId": {
                      "type": "string"
                    },
                    "addedMonths": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "revision": {
                      "type": "integer"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "localDate": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid origin or content type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Unable to save",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "mcp",
        "summary": "Stateless JSON-RPC: get_ledger_summary and apply_due_rent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "jsonrpc",
                  "method"
                ],
                "properties": {
                  "jsonrpc": {
                    "const": "2.0"
                  },
                  "id": {},
                  "method": {
                    "type": "string"
                  },
                  "params": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC result or error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "202": {
            "description": "Notification acknowledged"
          },
          "400": {
            "description": "Invalid JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Member": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "Entry": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "date",
          "description",
          "amountCents",
          "payerId"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "expense",
              "income",
              "transfer"
            ]
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "amountCents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "payerId": {
            "type": "string"
          },
          "payeeId": {
            "type": "string"
          },
          "shares": {
            "type": "object",
            "description": "Integer microcents: 1 cent = 1,000,000 units. Expense/income shares must sum to amountCents × 1,000,000.",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "category": {
            "type": "string"
          },
          "splitMode": {
            "enum": [
              "equal",
              "amount",
              "percent",
              "shares",
              "imported",
              "rent",
              "transfer"
            ]
          },
          "notes": {
            "type": "string",
            "maxLength": 4000
          },
          "deletedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "sourceRow": {
            "type": "integer"
          }
        }
      },
      "RentRule": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "startMonth": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "payerId": {
            "type": "string"
          },
          "memberIds": {
            "type": "object",
            "required": [
              "yuan",
              "zhang",
              "xu",
              "ge"
            ],
            "properties": {
              "yuan": {
                "type": "string"
              },
              "zhang": {
                "type": "string"
              },
              "xu": {
                "type": "string"
              },
              "ge": {
                "type": "string"
              }
            }
          }
        }
      },
      "Book": {
        "type": "object",
        "required": [
          "schemaVersion",
          "id",
          "title",
          "currency",
          "members",
          "entries"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,80}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "currency": {
            "const": "USD"
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Member"
            }
          },
          "entries": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "$ref": "#/components/schemas/Entry"
            }
          },
          "rentRule": {
            "$ref": "#/components/schemas/RentRule"
          }
        }
      },
      "BookResponse": {
        "type": "object",
        "required": [
          "book",
          "revision",
          "updatedAt"
        ],
        "properties": {
          "book": {
            "$ref": "#/components/schemas/Book"
          },
          "revision": {
            "type": "integer"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
